# App
APP_NAME=Grubzo
APP_PORT=80
APP_DOMAIN=grubzo.food

# Platform
PLATFORM_ADMIN_USER=
PLATFORM_ADMIN_PASSWORD=

# Database
DATABASE_TYPE=pg

# Redis
DATABASE_REDIS_HOST=localhost
DATABASE_REDIS_PORT=5434
DATABASE_REDIS_PASSWORD=
DATABASE_REDIS_DB=0
DATABASE_REDIS_TLS_ENABLED="false"

# PostgreSQL
DATABASE_SQL_HOST=127.0.0.1
DATABASE_SQL_PORT=5432
DATABASE_SQL_USERNAME=postgres
DATABASE_SQL_PASSWORD=postgres
DATABASE_SQL_DB=grubzo
DATABASE_SQL_MAX_OPEN=0
DATABASE_SQL_MAX_IDLE=0
DATABASE_SQL_LIFETIME=0

# SQLite
DATABASE_SQLITE_PATH=tmp/grubzo.db
DATABASE_SQLITE_MAX_OPEN=1
DATABASE_SQLITE_MAX_IDLE=1
DATABASE_SQLITE_LIFETIME=3600

# Storage
STORAGE_TYPE=local

# Local Storage
STORAGE_LOCAL_DIR=/tmp/grubzo

# S3
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

# OAuth Google
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://auth.grubzo.food/auth/v1/oauth/login/google/callback

# OAuth GitHub
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_CALLBACK_URL=http://auth.grubzo.food/auth/v1/oauth/login/github/callback

# Razorpay
PAYMENT_RAZORPAY_KEY_ID=
PAYMENT_RAZORPAY_KEY_SECRET=

# MCP
MCP_PORT=0
MCP_BASE_PATH=
MCP_SYSTEM_PROMPT=

# MCP LLM
MCP_LLM_PROVIDER=gemini
MCP_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
MCP_LLM_API_KEY=
MCP_LLM_MODEL=gemini-3.1-flash-lite-preview
MCP_LLM_TEMPERATURE=0.7
MCP_LLM_MAX_TOKENS=1000
MCP_LLM_TIMEOUT_SECONDS=30

# Observability
TEMPO_HOST=tmpo.observability:4318

# Security
JWT_256_BIT_SECRET=

# Runtime
ENV=prod
INSTANCE="mario"
SESSION_STORAGE=redis
PPROF=true
SHUTDOWN_TIMEOUT=5
